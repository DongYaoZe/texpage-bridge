{
  "name": "dsh-texpage-bridge",
  "version": "0.1.0",
  "description": "Low-privilege TeXPage build tools for the official DeepSeek Harness",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "texpage"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./runner": "./runner.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "runner.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
